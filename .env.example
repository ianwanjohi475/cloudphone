# ── cloudphone environment ────────────────────────────────────────────────
# Copy to `.env` and adjust. `make up` reads this file.

# Android image. Redroid tags: 11.0.0 / 12.0.0 / 13.0.0 / 14.0.0
# Use the *_64only-arm-arm64 / native-bridge tags for ARM app translation on x86.
ANDROID_VERSION=13.0.0
REDROID_IMAGE=redroid/redroid:${ANDROID_VERSION}

# Display
REDROID_WIDTH=720
REDROID_HEIGHT=1280
REDROID_DPI=320
REDROID_FPS=30

# GPU mode: guest = software (SwiftShader, most stable, no host GPU needed)
#           host  = passthrough (faster; needs /dev/dri + matching mesa drivers)
#           auto  = let redroid decide
REDROID_GPU_MODE=guest
REDROID_GPU_NODE=/dev/dri/renderD128

# Resources per phone
REDROID_MEMORY=4g
REDROID_CPUS=2

# Base host port for the first phone's adb (each phone = BASE + index)
ADB_BASE_PORT=5555

# ws-scrcpy web UI
SCRCPY_PORT=8000

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_SECRET=change-me-please

# Data root (persistent storage for all phones)
DATA_ROOT=./data

# Default outbound proxy for new phones (leave blank to disable)
# Format: socks5://user:pass@host:port  or  http://host:port
DEFAULT_PROXY=
