#!/usr/bin/env bash
# cloudphone: an Android phone with the Google Play Store, in your browser.
#
#   ./cloudphone start     install what is missing, boot the phone, print the link
#   ./cloudphone share     same, plus a public https link you can open anywhere
#   ./cloudphone link      print the link(s) again
#   ./cloudphone install <file>   install an .apk / .xapk / .apks / .apkm
#   ./cloudphone status | logs | stop | doctor
#   ./cloudphone crashes   show which apps crashed on the phone, and why
#   ./cloudphone reset     factory reset (deletes the phone's apps and data)
#
# Settings (environment variables):
#   PORT=8080      web port                 RAM_MB / CORES   phone size
#   API=34         Android version (34 = Android 14; 30 = Android 11, which
#                  also runs old 32-bit-only apps and games; changing needs reset)
#   WIDTH=720 HEIGHT=1600 DPI=320           screen
#   GPU=swiftshader_indirect  VULKAN=off    "host" / "on" with a real GPU
#   CLOUDPHONE_HOME=~/.cloudphone           where everything is kept
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CP_HOME="${CLOUDPHONE_HOME:-$HOME/.cloudphone}"
SDK="$CP_HOME/sdk"
RUN="$CP_HOME/run"
LOGS="$CP_HOME/logs"
BIN="$CP_HOME/bin"

API="${API:-34}"
IMAGE="system-images;android-${API};google_apis_playstore;x86_64"
AVD=cloudphone
SERIAL=emulator-5554
PORT="${PORT:-8080}"

CMDLINE_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
SCRCPY_VERSION=2.7
SCRCPY_URL="https://github.com/Genymobile/scrcpy/releases/download/v${SCRCPY_VERSION}/scrcpy-server-v${SCRCPY_VERSION}"
SCRCPY_SHA256=a23c5659f36c260f105c022d27bcb3eafffa26070e7baa9eda66d01377a1adba
CLOUDFLARED_URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64"

export ANDROID_SDK_ROOT="$SDK" ANDROID_HOME="$SDK"
export ANDROID_AVD_HOME="$CP_HOME/avd" ANDROID_EMULATOR_HOME="$CP_HOME/emulator-home"
ADB="$SDK/platform-tools/adb"

log()  { printf '\033[1;36m[cloudphone]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[cloudphone]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[cloudphone]\033[0m %s\n' "$*" >&2; exit 1; }

as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }

# ------------------------------------------------------------------ checks
check_host() {
  [[ "$(uname -s)" == Linux ]] || die "This runs on Linux (Ubuntu). On Windows use Ubuntu under WSL2."
  [[ "$(uname -m)" == x86_64 ]] || die "An x86_64 (Intel/AMD) machine is needed; this one is $(uname -m)."
  if [[ ! -e /dev/kvm ]]; then
    die "No /dev/kvm: hardware virtualization is off, and Android cannot run without it.
  - PC/laptop: turn on Intel VT-x / AMD-V (SVM) in the BIOS.
  - WSL2: needs Windows 11; put 'nestedVirtualization=true' under [wsl2] in
    %UserProfile%\\.wslconfig, then run 'wsl --shutdown' and reopen Ubuntu.
  - VPS: pick one that offers KVM / nested virtualization (many cheap ones do not)."
  fi
  if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    log "giving your user access to /dev/kvm (needs sudo)…"
    as_root usermod -aG kvm "$(id -un)" 2>/dev/null || true
    as_root chmod 666 /dev/kvm   # takes effect now; the group makes it stick after a re-login
  fi
}

cmd_doctor() {
  local ok=1 mem disk
  say() { printf '  %s %s\n' "$1" "$2"; }
  if [[ "$(uname -m)" == x86_64 ]]; then say ✓ "x86_64 CPU"; else say ✗ "CPU is $(uname -m), need x86_64"; ok=0; fi
  if [[ ! -e /dev/kvm ]]; then
    say ✗ "/dev/kvm missing: turn on virtualization (./cloudphone start explains how)"; ok=0
  elif [[ -w /dev/kvm ]]; then
    say ✓ "/dev/kvm usable"
  else
    say ! "/dev/kvm exists but is not writable (start fixes this with sudo)"
  fi
  mem=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
  if (( mem >= 6000 )); then say ✓ "${mem} MB RAM"; else say ! "${mem} MB RAM: 8 GB or more is recommended"; fi
  mkdir -p "$CP_HOME"
  disk=$(df -Pm "$CP_HOME" | awk 'NR==2 {print $4}')
  if (( disk >= 20000 )); then say ✓ "$((disk / 1024)) GB free disk"; else say ! "$((disk / 1024)) GB free disk: about 20 GB is needed"; fi
  if [[ -x "$SDK/emulator/emulator" ]]; then say ✓ "Android installed"; else say ! "Android not downloaded yet (start does it)"; fi
  if (( ok )); then echo "Ready: ./cloudphone start"; else echo "Not ready, see above."; return 1; fi
}

# ------------------------------------------------------------------- setup
install_packages() {
  local need=() pkg
  command -v java    >/dev/null || need+=(openjdk-17-jre-headless)
  command -v unzip   >/dev/null || need+=(unzip)
  command -v curl    >/dev/null || need+=(curl ca-certificates)
  command -v python3 >/dev/null || need+=(python3)
  python3 -c 'import aiohttp' 2>/dev/null || need+=(python3-aiohttp)
  if (( ${#need[@]} )); then
    log "installing packages (needs sudo): ${need[*]}"
    as_root apt-get update -qq
    as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${need[@]}"
  fi
  # Libraries the Android emulator loads. Names differ between Ubuntu
  # releases, so each is tried on its own and a miss is not fatal.
  if [[ ! -e "$CP_HOME/.libs-installed" ]]; then
    log "installing emulator libraries (needs sudo)…"
    for pkg in libpulse0 libnss3 libxcomposite1 libxcursor1 libxi6 libxtst6 libxdamage1 \
               libxkbfile1 libxrandr2 libdrm2 libgbm1 libx11-xcb1 libxcb1 libbsd0 libgl1 \
               libasound2t64 libasound2; do
      dpkg -s "$pkg" >/dev/null 2>&1 && continue
      as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$pkg" >/dev/null 2>&1 || true
    done
    touch "$CP_HOME/.libs-installed"
  fi
}

install_android() {
  local sdkmanager="$SDK/cmdline-tools/latest/bin/sdkmanager"
  if [[ ! -x "$sdkmanager" ]]; then
    log "downloading the Android SDK tools…"
    mkdir -p "$SDK/cmdline-tools"
    curl -fL --retry 3 -o "$CP_HOME/tools.zip" "$CMDLINE_TOOLS_URL"
    unzip -q -o "$CP_HOME/tools.zip" -d "$SDK/cmdline-tools"
    mv "$SDK/cmdline-tools/cmdline-tools" "$SDK/cmdline-tools/latest"
    : > "$CP_HOME/tools.zip"
  fi
  if [[ ! -x "$SDK/emulator/emulator" || ! -x "$ADB" || ! -d "$SDK/system-images/android-${API}/google_apis_playstore/x86_64" ]]; then
    log "downloading Android ${API} with Google Play (about 2 GB, once)…"
    # Downloading the emulator and system image requires accepting Google's SDK licences.
    yes 2>/dev/null | "$sdkmanager" --licenses >/dev/null || true
    "$sdkmanager" --install platform-tools emulator "$IMAGE" | grep -v '^\[' || true
    [[ -x "$SDK/emulator/emulator" && -x "$ADB" ]] || die "The Android download failed. Check your internet connection and run start again."
  fi
}

install_streamer() {
  local jar="$BIN/scrcpy-server.jar"
  [[ -f "$jar" ]] && return
  log "downloading the screen streamer (scrcpy server ${SCRCPY_VERSION})…"
  mkdir -p "$BIN"
  curl -fL --retry 3 -o "$jar.part" "$SCRCPY_URL"
  echo "$SCRCPY_SHA256  $jar.part" | sha256sum -c --quiet - || die "The screen streamer download is corrupt. Run start again."
  mv "$jar.part" "$jar"
}

create_phone() {
  local cfg="$ANDROID_AVD_HOME/$AVD.avd/config.ini" mem ram cores
  if [[ ! -f "$cfg" ]]; then
    log "creating the phone…"
    mkdir -p "$ANDROID_AVD_HOME" "$ANDROID_EMULATOR_HOME"
    echo no | "$SDK/cmdline-tools/latest/bin/avdmanager" create avd --force -n "$AVD" -k "$IMAGE" \
      -d "${DEVICE:-pixel_6}" -p "$ANDROID_AVD_HOME/$AVD.avd" >/dev/null
  fi
  mem=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
  ram="${RAM_MB:-$(( mem / 2 > 6144 ? 6144 : (mem / 2 < 2048 ? 2048 : mem / 2) ))}"
  cores="${CORES:-$(( $(nproc) > 4 ? 4 : $(nproc) ))}"
  setcfg() { if grep -q "^$1=" "$cfg"; then sed -i "s#^$1=.*#$1=$2#" "$cfg"; else echo "$1=$2" >> "$cfg"; fi; }
  setcfg hw.ramSize "$ram"
  setcfg hw.cpu.ncore "$cores"
  setcfg disk.dataPartition.size "${DISK:-16G}"
  setcfg hw.lcd.width "${WIDTH:-720}"
  setcfg hw.lcd.height "${HEIGHT:-1600}"
  setcfg hw.lcd.density "${DPI:-320}"
  setcfg hw.keyboard yes
  setcfg PlayStore.enabled true
  setcfg hw.gpu.enabled yes
  setcfg vm.heapSize 512

  # Without a real GPU the emulator's Vulkan is the usual reason Chrome,
  # WebView-based apps and games crash on launch. Turning it off makes them
  # draw through OpenGL (software), which is slower but stable.
  if [[ "${VULKAN:-off}" != on ]]; then
    printf 'Vulkan = off\nGLDirectMem = on\n' > "$ANDROID_EMULATOR_HOME/advancedFeatures.ini"
  else
    : > "$ANDROID_EMULATOR_HOME/advancedFeatures.ini"
  fi
}

# --------------------------------------------------------------- processes
alive() { [[ -f "$RUN/$1.pid" ]] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }

spawn() { # name command…   (detached, logging to $LOGS/name.log)
  local name="$1"; shift
  mkdir -p "$RUN" "$LOGS"
  nohup setsid "$@" >"$LOGS/$name.log" 2>&1 </dev/null &
  echo $! > "$RUN/$name.pid"
}

halt() { # name
  if alive "$1"; then kill "$(cat "$RUN/$1.pid")" 2>/dev/null || true; fi
  : > "$RUN/$1.pid"
}

token() {
  mkdir -p "$CP_HOME"
  if [[ ! -s "$CP_HOME/token" ]]; then
    (umask 077; head -c 18 /dev/urandom | base64 | tr -d '/+=\n' > "$CP_HOME/token")
  fi
  cat "$CP_HOME/token"
}

start_phone() {
  alive emulator && return
  local features=()
  [[ "${VULKAN:-off}" == on ]] || features=(-feature -Vulkan)
  log "powering on the phone…"
  spawn emulator "$SDK/emulator/emulator" -avd "$AVD" -port 5554 \
    -no-window -no-audio -no-boot-anim -no-snapshot \
    -gpu "${GPU:-swiftshader_indirect}" -accel on -netdelay none -netspeed full \
    "${features[@]}"
  sleep 3
  alive emulator || { tail -n 20 "$LOGS/emulator.log" >&2; die "The phone failed to start (log above, full log: $LOGS/emulator.log)."; }
}

start_server() {
  alive server && return
  "$ADB" start-server >/dev/null 2>&1 || true
  CP_ADB="$ADB" CP_SERIAL="$SERIAL" CP_PORT="$PORT" CP_HOST="${BIND:-127.0.0.1}" \
  CP_TOKEN="$(token)" CP_SCRCPY_JAR="$BIN/scrcpy-server.jar" CP_SCRCPY_VERSION="$SCRCPY_VERSION" \
    spawn server python3 "$ROOT/server/app.py"
  sleep 1
  alive server || { tail -n 20 "$LOGS/server.log" >&2; die "The web server failed to start. Is port $PORT in use? Try: PORT=8090 ./cloudphone start"; }
}

start_tunnel() {
  local cf="$BIN/cloudflared"
  if ! alive tunnel; then
    if [[ ! -x "$cf" ]]; then
      log "downloading cloudflared (makes the public link)…"
      mkdir -p "$BIN"
      curl -fL --retry 3 -o "$cf.part" "$CLOUDFLARED_URL" && chmod +x "$cf.part" && mv "$cf.part" "$cf"
    fi
    spawn tunnel "$cf" tunnel --no-autoupdate --url "http://127.0.0.1:$PORT"
  fi
  for _ in $(seq 1 30); do
    public_url >/dev/null && return
    alive tunnel || break
    sleep 1
  done
  warn "No public link yet; see $LOGS/tunnel.log. The local link still works."
}

public_url() {
  alive tunnel || return 1
  grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$LOGS/tunnel.log" 2>/dev/null | head -n 1 | grep .
}

cmd_link() {
  local key url
  key="$(token)"
  echo
  echo "  Open your phone:   http://localhost:$PORT/?key=$key"
  if url="$(public_url)"; then
    echo "  From anywhere:     $url/?key=$key"
    echo
    echo "  Anyone with the second link controls this phone, including any Google"
    echo "  account signed in on it. Share it only with people you trust."
  fi
  echo
}

wait_for_boot() {
  log "Android is booting (the first boot takes a few minutes; the link already works)…"
  for _ in $(seq 1 240); do
    if [[ "$("$ADB" -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]]; then
      log "the phone is on."
      return
    fi
    alive emulator || { tail -n 20 "$LOGS/emulator.log" >&2; die "The phone stopped while booting (log above)."; }
    sleep 3
  done
  warn "Still booting after 12 minutes. Check: ./cloudphone logs"
}

# ---------------------------------------------------------------- commands
cmd_start() {
  check_host
  mkdir -p "$CP_HOME" "$ANDROID_EMULATOR_HOME"
  install_packages
  install_android
  install_streamer
  create_phone
  start_phone
  start_server
  if [[ "${1:-}" == share ]]; then start_tunnel; fi
  cmd_link
  wait_for_boot
}

cmd_stop() {
  if alive emulator; then "$ADB" -s "$SERIAL" emu kill >/dev/null 2>&1 || true; fi
  halt tunnel
  halt server
  for _ in 1 2 3 4 5; do alive emulator || break; sleep 1; done
  halt emulator
  log "stopped. Your apps and data are kept; ./cloudphone start brings the phone back."
}

cmd_status() {
  local name
  for name in emulator server tunnel; do
    if alive "$name"; then echo "  $name: running"; else echo "  $name: stopped"; fi
  done
  if alive server; then cmd_link; fi
}

cmd_install() {
  local file="${1:-}"
  [[ -f "$file" ]] || die "usage: ./cloudphone install <file.apk|.xapk|.apks|.apkm>"
  alive server || die "The phone is not running. Start it first: ./cloudphone start"
  log "installing $(basename "$file")…"
  curl -sS -b "cp_key=$(token)" -F "file=@$file" "http://127.0.0.1:$PORT/api/install"
  echo
}

cmd_crashes() {
  alive emulator || die "The phone is not running. Start it first: ./cloudphone start"
  echo "--- phone: Android $("$ADB" -s "$SERIAL" shell getprop ro.build.version.release | tr -d '\r')," \
       "CPU types $("$ADB" -s "$SERIAL" shell getprop ro.product.cpu.abilist | tr -d '\r')," \
       "RAM $("$ADB" -s "$SERIAL" shell cat /proc/meminfo | awk '/MemTotal/ {print int($2/1024)" MB"}')"
  echo "--- recent app crashes (newest last)"
  "$ADB" -s "$SERIAL" logcat -b crash -d -t 120
  echo "--- emulator warnings"
  grep -iE 'error|fatal|vulkan|gpu' "$LOGS/emulator.log" | tail -n 15 || true
}

cmd_reset() {
  local answer
  read -r -p "Factory reset: delete every app, account and file on the phone? [y/N] " answer
  [[ "$answer" == [yY]* ]] || { echo "Nothing changed."; return; }
  cmd_stop
  # Deleting the virtual device makes the next start create a blank one.
  "$SDK/cmdline-tools/latest/bin/avdmanager" delete avd -n "$AVD" >/dev/null
  log "phone erased. ./cloudphone start makes a fresh one."
}

case "${1:-start}" in
  start)   cmd_start ;;
  share)   cmd_start share ;;
  link)    cmd_link ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  doctor)  cmd_doctor ;;
  install) cmd_install "${2:-}" ;;
  reset)   cmd_reset ;;
  crashes) cmd_crashes ;;
  logs)    tail -n 40 "$LOGS"/*.log ;;
  *)       sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
